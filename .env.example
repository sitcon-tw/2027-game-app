# Copy to .env and pass --dart-define-from-file=.env to Flutter.
# Comma-separated HTTPS origins or HTTP loopback. These values ship in the app; no secrets.
TEST_SERVER_URLS=https://api.example.com,http://127.0.0.1:8787
API_BASE_URL=https://api.example.com
# Leave empty to choose a mode at startup; or set demo or server.
APP_MODE=
TEST_GAMEPLAY=true
